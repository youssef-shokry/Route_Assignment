<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainContactsActivity"
    android:padding="16dp"
    android:background="@color/darkBlue"
    android:scrollbars="vertical"
    android:scrollbarSize="50dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/emptyListPic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="224dp"
        app:layout_constraintStart_toStartOf="@id/emptyListText"
        app:layout_constraintEnd_toEndOf="@id/emptyListText"
        app:layout_constraintBottom_toTopOf="@id/emptyListText"
        android:src="@drawable/list"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/emptyListText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/emptyListPic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/emptyListText"
        style="@style/goldTextStyle"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/routeLogo"
        android:layout_marginTop="26dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        android:scrollbars="vertical"
        android:scrollbarSize="0dp"/>


<com.google.android.material.button.MaterialButton
    android:id="@+id/addItemButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    android:background="@drawable/gold_border"
    style="@style/buttonStyle"
    app:backgroundTint="@color/gold"
    android:text="@string/Add"
    android:textSize="35sp"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/route_"
        android:id="@+id/routeLogo"
        />
</androidx.constraintlayout.widget.ConstraintLayout>